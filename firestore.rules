rules_version = '2';
// Security rules for the PBT VSE crew chat. Paste these into Firebase console → Firestore → Rules.
// Anyone using the app is signed in anonymously; they can read the room, post their own messages
// (short text, their own sign-in, server time), and delete only their own messages. Nothing can be edited.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{room}/messages/{id} {
      allow read: if request.auth != null && room == 'main';
      allow create: if request.auth != null && room == 'main'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.ts == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
